{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "*.{js,css,webp,png,jpg,jpeg,gif,svg,ico,mp3,json,txt,xml,woff,woff2}"
    ]
  },
  "routes": [
    {
      "route": "/assets/audio/*",
      "headers": { "cache-control": "public, max-age=604800" }
    },
    {
      "route": "/assets/sprites/*",
      "headers": { "cache-control": "public, max-age=604800" }
    },
    {
      "route": "/assets/images/*",
      "headers": { "cache-control": "public, max-age=604800" }
    },
    {
      "route": "/assets/CREDITS.md",
      "headers": { "cache-control": "no-cache" }
    },
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/index.html",
      "headers": { "cache-control": "no-cache" }
    },
    {
      "route": "/",
      "headers": { "cache-control": "no-cache" }
    }
  ],
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; manifest-src 'self'; upgrade-insecure-requests",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".webp": "image/webp",
    ".md": "text/markdown; charset=utf-8"
  }
}
