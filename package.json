{
  "name": "mathbasher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "A browser-based math game for kids. Aliens descend carrying answers; fire at the right one before they reach the hero.",
  "homepage": "https://github.com/rklundt/mathBasher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rklundt/mathBasher.git"
  },
  "bugs": {
    "url": "https://github.com/rklundt/mathBasher/issues"
  },
  "author": "Ray Klundt",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "phaser": "^3.80.1"
  }
}
