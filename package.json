{
  "name": "mathbasher",
  "private": true,
  "version": "2.8.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "A browser math game for kids: arcade mini-games for phones, tablets and computers.",
  "homepage": "https://github.com/rklundt/mathBasher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rklundt/mathBasher.git"
  },
  "bugs": {
    "url": "https://github.com/rklundt/mathBasher/issues"
  },
  "author": "Ray Klundt",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server/dist/server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-hooks.mjs",
    "audio:encode": "node scripts/audio/encode.mjs",
    "audio:probe": "node scripts/audio/probe.mjs",
    "sprite:process": "node scripts/sprites/process.mjs",
    "sprite:probe": "node scripts/sprites/probe.mjs",
    "sprite:extract": "node scripts/sprites/extract-from-video.mjs",
    "sprite:axolotl": "node scripts/sprites/axolotl.mjs",
    "sprite:reef": "node scripts/sprites/reef.mjs",
    "sprite:frog": "node scripts/sprites/frog.mjs",
    "sprite:pond": "node scripts/sprites/pond.mjs",
    "sprite:alienships": "node scripts/sprites/alienships.mjs",
    "sprite:cockpit": "node scripts/sprites/cockpit.mjs",
    "sprite:penguin": "node scripts/sprites/penguin.mjs",
    "sprite:fish": "node scripts/sprites/fish.mjs",
    "sprite:snowhill": "node scripts/sprites/snowhill.mjs",
    "sprite:bunny": "node scripts/sprites/bunny.mjs",
    "sprite:carrot": "node scripts/sprites/carrot.mjs",
    "sprite:garden": "node scripts/sprites/garden.mjs",
    "icon:favicon": "node scripts/sprites/favicon.mjs"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "ffmpeg-static": "5.2.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "express": "^4.22.3",
    "phaser": "^3.80.1"
  }
}
