# =============================================================================
# pnpm configuration. Goal: a fully portable, self-contained install — every
# package and the pnpm content store live INSIDE this project directory. Cloning
# the repo to a USB stick or fresh machine and running `pnpm install` produces
# an identical install regardless of any pre-existing global pnpm state.
# =============================================================================

# Flat node_modules — Windows + Vite friendly, avoids pnpm's symlink ENOENT
# issues on NTFS, and makes the install structure visually identical to npm's.
node-linker=hoisted

# Project-local content-addressable store. Without this, pnpm shares a global
# store at ~/.local/share/pnpm/store (or %LOCALAPPDATA%\pnpm\store on Windows),
# which makes installs faster across projects but couples this repo to whatever
# the developer happens to have cached. Local store keeps the project portable.
store-dir=.pnpm-store

# Don't write to the system `node_modules`-bin shim folder; everything goes into
# this project's local node_modules.
prefer-frozen-lockfile=true

# Quiet noisy install output; CI is the place for verbose logs.
fund=false
audit=false
