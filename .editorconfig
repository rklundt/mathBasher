root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# Markdown allows trailing whitespace as a hard line break
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

[*.{ps1,bat,cmd}]
end_of_line = crlf
