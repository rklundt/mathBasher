# =============================================================================
# .dockerignore — controls what gets sent as build context to docker build.
# Goal: ship only the source files needed to build the image, NEVER ship
# secrets, internal tooling, build artifacts, IDE state, OS junk, or VCS data.
# =============================================================================

# ---------- Dependencies (always rebuilt in the image) ----------
node_modules
**/node_modules
.pnpm-store
**/.pnpm-store

# ---------- Version control ----------
.git
.gitignore
.gitattributes
.github
**/.git

# ---------- Editor / IDE / OS ----------
.editorconfig
.vscode
.idea
*.swp
*.swo
*~
*.bak
.DS_Store
Thumbs.db
desktop.ini

# ---------- Secrets and env ----------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets/
.aws/
.ssh/
.azure/

# ---------- Build artifacts (regenerated inside the image) ----------
dist
server/dist
build
out
coverage
.nyc_output
*.tsbuildinfo

# ---------- Internal workspace files (NEVER enter image) ----------
# Local development scaffolding — workflow notes, sprint planning drafts,
# ADR working copies, etc. Both the directory pattern AND the recursive
# glob, defense-in-depth in case a future refactor adds a broad COPY.
CLAUDE.md
.claude
.claude/**
.sprints
.sprints/**
.adrs
.adrs/**
backlog.md

# ---------- Repo docs we don't ship in the image ----------
docs

# ---------- Logs ----------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
logs

# ---------- Tests (runtime image is for serving, not testing) ----------
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
__tests__
test
tests

# ---------- Markdown at repo root: ship only the public-facing legal/community files ----------
*.md
!README.md
!LICENSE
!NOTICE
!COMMERCIAL.md
!CODE_OF_CONDUCT.md
!CONTRIBUTING.md
!SECURITY.md
!public/assets/CREDITS.md

# ---------- Docker meta itself doesn't need to be in the image ----------
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# ---------- Misc ----------
.husky
.changeset
*.tar
*.gz
*.zip
