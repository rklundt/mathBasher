{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "./server/dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  // Server compiles its own source PLUS the shared modules it consumes.
  // rootDir is the project root so cross-folder imports (server/src ->
  // src/shared) stay valid; outputs land under server/dist mirroring the
  // source tree (e.g. server/dist/server/src/index.js).
  "include": ["server/src/**/*.ts", "src/shared/**/*.ts"]
}
