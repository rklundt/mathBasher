# mathBasher environment variables.
# Copy this file to .env (which is gitignored) and fill in real values.
# In production (Azure App Service), these are set as App Settings, not from a file.

# ---------- Server ----------
# Port the Express server listens on. Azure App Service injects this; default is 8080 locally.
PORT=8080

# CI sets this to the commit SHA so /health and telemetry can report which build is running.
# Locally it defaults to 'dev'.
# BUILD_HASH=

# ---------- Telemetry ----------
# Application Insights connection string. Optional locally; the telemetry helper falls back to
# console output when this is unset. In production this comes from a Key Vault reference.
# APPINSIGHTS_CONNECTION_STRING=

# ---------- Browser ----------
# Public URL of the source repository. Surfaced to end users in the AGPL §7(b) UI attribution
# footer (see src/core/attribution.ts) so users can access the corresponding source per AGPL §13.
# Vite inlines variables prefixed with VITE_ into the client bundle at build time.
VITE_SOURCE_URL=https://github.com/rklundt/mathBasher
