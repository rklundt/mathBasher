# Commit-message checks (sprint 2.6.4): hands the message file to the
# optional machine-local checks in .githooks/local/ (gitignored). A commit
# message is permanent once pushed, so it gets the same local checks as code.

cd "$(git rev-parse --show-toplevel)" || exit 1
# ':(icase)' also catches .githooks/Local/ etc., which Windows treats as the same folder.
tracked=$(git ls-files ':(icase).githooks/local') || { echo "could not check .githooks/local; refusing to run." >&2; exit 1; }
if [ -n "$tracked" ]; then
  echo "commit-msg: .githooks/local/ contains tracked files; refusing to run. Remove them from git." >&2
  exit 1
fi
exec sh .githooks/run-local.sh commit-msg "$1"
